# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://pati:pati@localhost:5433/patireminder"
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`
JWT_SECRET=""
PORT=4000
# Comma-separated list of origins allowed to call the API (the web panel).
CORS_ORIGIN="http://localhost:5173,http://localhost:8081"
REMINDERS_ENABLED=true
